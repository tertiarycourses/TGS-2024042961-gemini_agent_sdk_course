# Copy this file to .env in the labs/ folder and fill in your own keys.
#   cp .env.example .env
#
# NEVER commit your .env file — it is git-ignored.

# Use the Google AI Studio API key (not Vertex AI service-account credentials)
GOOGLE_GENAI_USE_VERTEXAI=0

# Required — get a free key at https://aistudio.google.com  (Get API key -> Create API key)
GOOGLE_API_KEY=your-google-api-key

# Optional — free key at https://openweathermap.org (used by the tool-calling labs)
OPENWEATHER_API_KEY=your-openweather-key

# Optional — free key at https://tavily.com (used by the web-search labs)
TAVILY_API_KEY=your-tavily-key

# Optional — only for Lab 4 (running an ADK agent on a non-Gemini model via LiteLlm)
OPENAI_API_KEY=your-openai-key
